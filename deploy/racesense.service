[Unit]
Description=RaceSense Datalogger Web Server
After=network.target

[Service]
Type=notify
User=root
Group=root
WorkingDirectory=/var/www/racesense/server
EnvironmentFile=/var/www/racesense/.env
Environment=FLASK_APP=run
Environment=PYTHONPATH=/var/www/racesense/server:/var/www/racesense/server/api:/var/www/racesense/src
ExecStartPre=/var/www/racesense/server/venv/bin/flask db upgrade
ExecStart=/var/www/racesense/server/venv/bin/gunicorn --config gunicorn.conf.py 'run:app'
ExecReload=/bin/kill -HUP $MAINPID
KillMode=mixed
Restart=always
RestartSec=5

# Security hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
