[Unit]
Description=RaceSense Background Worker
After=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/var/www/racesense/server
EnvironmentFile=/var/www/racesense/.env
ExecStart=/var/www/racesense/server/venv/bin/python worker.py
Restart=always
RestartSec=5

# Security hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
