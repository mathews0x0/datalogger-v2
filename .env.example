# RaceSense Server Configuration
# Copy this file to .env and update values for your environment.

# Set to 'production' on VPS, 'development' for local dev
FLASK_ENV=production

# REQUIRED in production — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING

# Comma-separated list of allowed CORS origins (your domain)
# Leave unset in development to use default localhost origins
CORS_ORIGINS=https://yourdomain.com
